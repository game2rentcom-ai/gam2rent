# Copy to .env.local (git-ignored) and fill in. Vite only exposes VITE_* vars, and everything here
# ends up in the public JS bundle — so only ever put PUBLIC values here.

VITE_SUPABASE_URL=https://cggdhfuifudpefursrzn.supabase.co
# The "anon" / "public" key (Supabase -> Project Settings -> API). NEVER the service_role key.
VITE_SUPABASE_ANON_KEY=

# Country code + number, digits only, no "+" (e.g. 919876543210). A production build without it
# renders inert contact buttons.
VITE_WHATSAPP_NUMBER=

# true = show clearly-labelled illustrative listings/reviews when Supabase is not configured.
VITE_DEMO_DATA=
